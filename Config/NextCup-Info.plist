<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>app.rarecreatures.nextcup</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>nextcup</string>
			</array>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSCameraUsageDescription</key>
	<string>Next Cup uses the camera when you ask, to photograph a brew or a coffee bag, or to scan the bag's barcode or QR code. Photos stay on your iPhone unless you send one to your AI provider.</string>
	<key>NSLocationDefaultAccuracyReduced</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Next Cup uses your location once, when you ask, to find coffee roasters near you. It is not stored.</string>
</dict>
</plist>
